# PIN for the kitchen display at /kitchen (4–8 digits). Change before going live.
KITCHEN_PIN=2468
# Optional. Signs the kitchen sign-in cookie. Without it a random secret is made at
# startup, so staff re-enter the PIN after each restart. Use a long random string.
# SESSION_SECRET=
# Optional. Where the SQLite database lives (folder is created if missing).
# Defaults to a Railway volume if attached, otherwise ./data/the-usual.db.
# DATABASE_PATH=./data/the-usual.db
# Optional. Public site URL for metadata, sitemap and Open Graph (applied at build time).
NEXT_PUBLIC_SITE_URL=https://theusualcoffee.in
