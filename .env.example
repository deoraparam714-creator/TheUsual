# PIN for the kitchen display at /kitchen (4–8 digits). Change before going live.
KITCHEN_PIN=2468
# Secret used to sign the kitchen session cookie. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite database lives. The folder is created if missing.
DATABASE_PATH=./data/the-usual.db
# Public site URL, used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://theusualcoffee.in
